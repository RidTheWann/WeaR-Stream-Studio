/* ------------------------------------------------------------------------- *
 * WeaR Stream — Compact Minimal Pro (Dark)
 * Extends Yami. Palette ungu WeaR, chrome tipis, preview menonjol.
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'WeaR Dark';
    id: 'com.wearstudio.WeARDark';
    extends: 'com.obsproject.Yami';
    author: 'WeaR Stream';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #101014;
    --bg_base: #16161C;
    --bg_preview: #070709;
    --bg_card: #1A1A22;

    --primary: #7C3AED;
    --primary_light: #9D5CFF;
    --primary_lighter: #C4B5FD;
    --primary_dark: #6D28D9;
    --primary_darker: #4C1D95;
    --highlight_color: #A78BFA;

    --text: #F4F4F7;
    --text_light: #FFFFFF;
    --text_muted: #8B8B9A;
    --text_disabled: #5C5C6B;

    --border_color: #2A2A35;
    --input_bg: #1E1E26;
    --input_bg_hover: #25252F;
    --input_bg_focus: #14141A;
    --button_bg: #1E1E26;
    --button_bg_hover: #2A2A36;
    --button_bg_down: #121218;
    --button_border: #2A2A35;
    --button_border_hover: #9D5CFF;

    --list_item_bg_selected: #7C3AED;
    --list_item_bg_hover: #2A2340;

    --border_radius: 4px;
    --border_radius_small: 2px;
    --border_radius_large: 6px;

    --padding_wide: 10px;
    --padding_menu: 6px;
    --padding_menubar: 4px;
    --padding_container: 3px;
    --scrollbar_size: 8px;

    --palette_highlight: #7C3AED;
    --palette_link: #A78BFA;
    --palette_linkVisited: #9D5CFF;
}

QMainWindow { background-color: var(--bg_window); }
QDialog { background-color: var(--bg_window); }

QMainWindow::separator {
    background: var(--border_color);
    width: 3px;
    height: 3px;
}
QMainWindow::separator:hover {
    background: var(--primary);
}

QMenuBar {
    background-color: var(--bg_window);
    color: var(--text_muted);
    padding: 0px 4px;
    border-bottom: 1px solid var(--border_color);
}
QMenuBar::item {
    padding: 4px 8px;
    border-radius: 3px;
    background: transparent;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: var(--button_bg_hover);
    color: var(--text);
}

QMenu {
    background-color: var(--bg_card);
    border: 1px solid var(--border_color);
    border-radius: 4px;
    padding: 4px;
}
QMenu::item {
    padding: 5px 10px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: var(--primary);
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background: var(--border_color);
    margin: 4px 6px;
}

QDockWidget {
    color: var(--text_muted);
    font-weight: 600;
    titlebar-close-icon: url(theme:Dark/close.svg);
    titlebar-normal-icon: url(theme:Dark/popout.svg);
}
QDockWidget::title {
    background-color: var(--bg_base);
    color: var(--text_muted);
    text-align: left;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid var(--border_color);
    font-weight: 600;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    border-radius: 3px;
    icon-size: 12px;
    padding: 2px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: var(--button_bg_hover);
}
OBSDock > QWidget {
    background: var(--bg_base);
    border: none;
    border-top: 1px solid var(--border_color);
}
OBSDock QToolBar {
    padding: 2px;
    spacing: 2px;
    border: none;
}
OBSDock QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px;
    icon-size: 14px;
}
OBSDock QToolBar QToolButton:hover {
    background: var(--button_bg_hover);
    border-color: var(--border_color);
}

#canvasEditor {
    background-color: var(--bg_window);
    padding: 2px;
}
#previewContainer { background-color: var(--bg_window); }
OBSQTDisplay, #preview {
    background-color: #000000;
    border: 1px solid var(--border_color);
    border-radius: 2px;
}
#previewLabel {
    color: var(--text_muted);
    font-size: 9pt;
    font-weight: 600;
    padding: 2px 0px;
}
#contextContainer {
    background-color: var(--bg_base);
    border: 1px solid var(--border_color);
    border-radius: 3px;
    margin-top: 2px;
}

QPushButton {
    background-color: var(--button_bg);
    color: var(--text);
    border: 1px solid var(--border_color);
    border-radius: 4px;
    min-height: 26px;
    max-height: 32px;
    padding: 4px 10px;
    font-weight: 600;
}
QPushButton:hover, QPushButton:focus {
    background-color: var(--button_bg_hover);
    border-color: var(--primary_light);
}
QPushButton:pressed {
    background-color: var(--button_bg_down);
    border-color: var(--primary);
}
QPushButton:checked {
    background-color: var(--primary);
    border-color: var(--primary_light);
    color: #FFFFFF;
}
QPushButton:disabled {
    color: var(--text_disabled);
    background: #14141A;
    border-color: #22222C;
}

#streamButton {
    min-height: 32px;
    max-height: 36px;
    font-weight: 700;
    border-radius: 4px;
}
#streamButton:!hover:!pressed {
    background: var(--primary);
    border: 1px solid var(--primary_light);
    color: #FFFFFF;
}
#streamButton:hover:!pressed {
    background: var(--primary_light);
    border-color: var(--primary_lighter);
    color: #FFFFFF;
}
#streamButton:pressed {
    background: var(--primary_dark);
}
#streamButton.state-active:!hover {
    background: #1A1214;
    border: 1px solid #C01C37;
    color: #FFFFFF;
}
#streamButton.state-active:hover {
    background: #2A1619;
    border-color: #E33B57;
}

#recordButton {
    min-height: 28px;
    max-height: 32px;
    font-weight: 700;
}
#recordButton:!hover:!pressed {
    background: var(--bg_card);
    border: 1px solid var(--primary);
    color: var(--text);
}
#recordButton:hover:!pressed {
    background: #2A2340;
    border-color: var(--primary_light);
}
#recordButton.state-active {
    background: #1A1214;
    border-color: #C01C37;
    color: #FFFFFF;
}

#broadcastButton, #replayBufferButton, #virtualCamButton, #modeSwitch, #settingsButton {
    min-height: 26px;
    max-height: 30px;
}
#settingsButton {
    background: transparent;
    border: 1px solid var(--border_color);
    color: var(--text);
}
#settingsButton:hover {
    border-color: var(--primary_light);
    background: var(--button_bg_hover);
}
#modeSwitch {
    background: transparent;
    border: 1px dashed var(--border_color);
    color: var(--text_muted);
}
#modeSwitch:hover {
    color: var(--text);
    border-color: var(--primary_light);
}
#modeSwitch.state-active {
    background: var(--primary);
    border: 1px solid var(--primary_light);
    color: #FFFFFF;
}
#pauseRecordButton, #saveReplayButton, #virtualCamConfigButton {
    min-width: 28px;
    min-height: 26px;
    max-height: 30px;
    padding: 3px;
}

QToolButton, .btn-tool {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px;
    icon-size: 14px;
}
QToolButton:hover, .btn-tool:hover {
    background-color: var(--button_bg_hover);
    border-color: var(--border_color);
}
QToolButton:checked, .btn-tool:checked {
    background-color: var(--primary);
    border-color: var(--primary_light);
}

QComboBox, QDateTimeEdit, QSpinBox, QDoubleSpinBox, QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: var(--input_bg);
    border: 1px solid var(--border_color);
    border-radius: 3px;
    padding: 3px 6px;
    min-height: 22px;
}
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #3A3A48;
}
QComboBox:focus, QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:on {
    border-color: var(--primary_light);
}
QComboBox QAbstractItemView {
    background-color: var(--bg_card);
    border: 1px solid var(--border_color);
    selection-background-color: var(--primary);
    outline: none;
}

QListWidget, QListView, SourceTree, SceneTree {
    background-color: var(--bg_base);
    border: none;
    outline: none;
    padding: 2px;
}
QListWidget::item, QListView::item, SourceTreeItem {
    padding: 4px 6px;
    border-radius: 3px;
    border: 1px solid transparent;
    min-height: 20px;
}
QListWidget::item:hover, QListView::item:hover {
    background: var(--list_item_bg_hover);
}
QListWidget::item:selected, QListView::item:selected {
    background-color: var(--primary);
    color: #FFFFFF;
}

QTabBar::tab {
    background: var(--bg_base);
    color: var(--text_muted);
    border: 1px solid var(--border_color);
    padding: 5px 10px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
QTabBar::tab:selected {
    background: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary_light);
}

QGroupBox {
    background: transparent;
    border: 1px solid var(--border_color);
    border-radius: 4px;
    padding-top: 18px;
    margin-top: 4px;
    font-weight: 600;
}

QScrollBar:vertical { background: transparent; width: 8px; margin: 1px; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 1px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #3A3A48;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover { background: var(--primary); }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; border: none; }

OBSBasicStatusBar {
    background: #0C0C10;
    border-top: 1px solid var(--border_color);
    padding: 0px 6px;
}
StatusBarWidget > QFrame {
    border: none;
    border-left: 1px solid var(--border_color);
    padding: 2px 8px;
    color: var(--text_muted);
}
#streamTime, #recordTime, #kbps, #fpsCurrent, #cpuUsage {
    color: var(--text);
    font-weight: 600;
}

QSlider::groove:horizontal { height: 3px; background: #2A2A35; border-radius: 2px; }
QSlider::groove:vertical { width: 3px; background: #2A2A35; border-radius: 2px; }
QSlider::sub-page:horizontal { background: var(--primary); border-radius: 2px; }
QSlider::add-page:vertical { background: var(--primary); border-radius: 2px; }
QSlider::handle:horizontal, QSlider::handle:vertical {
    background: #FFFFFF;
    border: 1px solid var(--primary_light);
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

VolumeControl {
    background: transparent;
    border: none;
    padding: 1px;
}
.btn-mute, .btn-monitor {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    icon-size: 14px;
    padding: 3px;
}

QProgressBar {
    background: #14141A;
    border: 1px solid var(--border_color);
    border-radius: 3px;
    text-align: center;
    min-height: 10px;
}
QProgressBar::chunk {
    background: var(--primary);
    border-radius: 2px;
}

QToolTip {
    background-color: var(--bg_card);
    color: #FFFFFF;
    border: 1px solid var(--border_color);
    border-radius: 3px;
    padding: 4px 6px;
}

QTableView {
    background: var(--bg_base);
    gridline-color: var(--border_color);
    border: 1px solid var(--border_color);
}

#transitionsFrame { padding: 4px; }
#transitions { min-width: 120px; }

.button-primary {
    background: var(--primary);
    border-color: var(--primary_light);
    color: #FFFFFF;
    font-weight: 700;
}
.button-primary:hover { background: var(--primary_light); }

.text-heading { color: var(--text); font-weight: 700; }
.text-muted { color: var(--text_muted); }
