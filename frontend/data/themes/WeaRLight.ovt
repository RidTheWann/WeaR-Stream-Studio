/* ------------------------------------------------------------------------- *
 * WeaR Stream — Compact Minimal Pro (Light)
 * Companion terang dari WeaR Dark. Aksen ungu WeaR, chrome tipis.
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'WeaR Light';
    id: 'com.wearstudio.WeARLight';
    extends: 'com.obsproject.Yami';
    author: 'WeaR Stream';
    dark: 'false';
}

@OBSThemeVars {
    --bg_window: #F3F3F7;
    --bg_base: #FFFFFF;
    --bg_preview: #0A0A0E;
    --bg_card: #FFFFFF;

    --primary: #7C3AED;
    --primary_light: #8B5CF6;
    --primary_lighter: #A78BFA;
    --primary_dark: #6D28D9;
    --primary_darker: #5B21B6;
    --highlight_color: #7C3AED;

    --text: #16161D;
    --text_light: #16161D;
    --text_muted: #5C5C6B;
    --text_disabled: #9A9AAB;

    --border_color: #D8D8E2;
    --input_bg: #FFFFFF;
    --input_bg_hover: #F4F4F8;
    --input_bg_focus: #FFFFFF;
    --button_bg: #FFFFFF;
    --button_bg_hover: #EEEFF5;
    --button_bg_down: #E2E2EA;
    --button_border: #D8D8E2;
    --button_border_hover: #8B5CF6;

    --list_item_bg_selected: #7C3AED;
    --list_item_bg_hover: #EFE8FF;

    --border_radius: 4px;
    --border_radius_small: 2px;
    --border_radius_large: 6px;

    --padding_wide: 10px;
    --padding_menu: 6px;
    --padding_menubar: 4px;
    --padding_container: 3px;
    --scrollbar_size: 8px;

    --palette_window: #F3F3F7;
    --palette_windowText: #16161D;
    --palette_base: #FFFFFF;
    --palette_text: #16161D;
    --palette_highlight: #7C3AED;
    --palette_highlightedText: #FFFFFF;
    --palette_button: #FFFFFF;
    --palette_buttonText: #16161D;
    --palette_link: #7C3AED;
}

QMainWindow, QDialog { background-color: var(--bg_window); color: var(--text); }
QWidget { color: var(--text); }

QMainWindow::separator {
    background: var(--border_color);
    width: 3px;
    height: 3px;
}
QMainWindow::separator:hover { background: var(--primary); }

QMenuBar {
    background-color: var(--bg_window);
    color: var(--text_muted);
    padding: 0px 4px;
    border-bottom: 1px solid var(--border_color);
}
QMenuBar::item { padding: 4px 8px; border-radius: 3px; background: transparent; }
QMenuBar::item:selected, QMenuBar::item:pressed { background: var(--button_bg_hover); color: var(--text); }

QMenu {
    background-color: #FFFFFF;
    border: 1px solid var(--border_color);
    border-radius: 4px;
    padding: 4px;
}
QMenu::item { padding: 5px 10px; border-radius: 3px; }
QMenu::item:selected { background-color: var(--primary); color: #FFFFFF; }
QMenu::separator { height: 1px; background: var(--border_color); margin: 4px 6px; }

QDockWidget { color: var(--text_muted); font-weight: 600; }
QDockWidget::title {
    background-color: #FFFFFF;
    color: var(--text_muted);
    text-align: left;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid var(--border_color);
}
OBSDock > QWidget {
    background: #FFFFFF;
    border: none;
    border-top: 1px solid var(--border_color);
}

#canvasEditor, #previewContainer { background-color: var(--bg_window); }
OBSQTDisplay, #preview {
    background-color: #000000;
    border: 1px solid var(--border_color);
    border-radius: 2px;
}
#previewLabel { color: var(--text_muted); font-size: 9pt; font-weight: 600; padding: 2px 0px; }
#contextContainer {
    background-color: #FFFFFF;
    border: 1px solid var(--border_color);
    border-radius: 3px;
    margin-top: 2px;
}

QPushButton {
    background-color: var(--button_bg);
    color: var(--text);
    border: 1px solid var(--border_color);
    border-radius: 4px;
    min-height: 26px;
    max-height: 32px;
    padding: 4px 10px;
    font-weight: 600;
}
QPushButton:hover, QPushButton:focus { border-color: var(--primary_light); background: var(--button_bg_hover); }
QPushButton:checked { background: var(--primary); color: #FFFFFF; border-color: var(--primary_light); }

#streamButton {
    min-height: 32px;
    max-height: 36px;
    font-weight: 700;
}
#streamButton:!hover:!pressed {
    background: var(--primary);
    border: 1px solid var(--primary_light);
    color: #FFFFFF;
}
#streamButton:hover:!pressed {
    background: var(--primary_light);
    color: #FFFFFF;
}
#streamButton.state-active:!hover {
    background: #FFFFFF;
    border: 1px solid #C01C37;
    color: #16161D;
}

#recordButton { min-height: 28px; max-height: 32px; font-weight: 700; }
#recordButton:!hover:!pressed {
    background: #FFFFFF;
    border: 1px solid var(--primary);
    color: var(--text);
}
#recordButton.state-active { border-color: #C01C37; color: #C01C37; }

#broadcastButton, #replayBufferButton, #virtualCamButton, #modeSwitch, #settingsButton {
    min-height: 26px;
    max-height: 30px;
}
#settingsButton { background: transparent; border: 1px solid var(--border_color); }
#settingsButton:hover { border-color: var(--primary); }
#modeSwitch { background: transparent; border: 1px dashed var(--border_color); color: var(--text_muted); }
#modeSwitch.state-active { background: var(--primary); color: #FFFFFF; border: 1px solid var(--primary_light); }

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: var(--input_bg);
    border: 1px solid var(--border_color);
    border-radius: 3px;
    padding: 3px 6px;
    min-height: 22px;
    color: var(--text);
}
QComboBox:focus, QLineEdit:focus { border-color: var(--primary); }

QListWidget, QListView, SourceTree, SceneTree {
    background-color: #FFFFFF;
    border: none;
    outline: none;
}
QListWidget::item:selected, QListView::item:selected {
    background-color: var(--primary);
    color: #FFFFFF;
}

QTabBar::tab {
    background: #EEEFF5;
    color: var(--text_muted);
    border: 1px solid var(--border_color);
    padding: 5px 10px;
}
QTabBar::tab:selected { background: var(--primary); color: #FFFFFF; border-color: var(--primary_light); }

OBSBasicStatusBar {
    background: #E8E8EE;
    border-top: 1px solid var(--border_color);
}
StatusBarWidget > QFrame {
    border: none;
    border-left: 1px solid var(--border_color);
    padding: 2px 8px;
}

QSlider::sub-page:horizontal, QSlider::add-page:vertical { background: var(--primary); }
QProgressBar::chunk { background: var(--primary); }

.icon-plus { qproperty-icon: url(theme:WeaRLight/plus.svg); }
.icon-minus { qproperty-icon: url(theme:WeaRLight/minus.svg); }
.icon-up { qproperty-icon: url(theme:WeaRLight/up.svg); }
.icon-down { qproperty-icon: url(theme:WeaRLight/down.svg); }
.icon-gear { qproperty-icon: url(theme:WeaRLight/settings/general.svg); }
.icon-filter { qproperty-icon: url(theme:WeaRLight/filter.svg); }

.button-primary {
    background: var(--primary);
    border-color: var(--primary_light);
    color: #FFFFFF;
    font-weight: 700;
}
