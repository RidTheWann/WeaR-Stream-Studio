/* ------------------------------------------------------------------------- *
 *                                                                           *
 *                            WeaRLight Variant Theme                        *
 *                          WeaR Stream Studio (phase 8)                     *
 *                                                                           *
 * Variant of Yami: inherits base styling, overrides brand tokens below.   *
 * Explicit per-widget rules (normal/hover/pressed/selected/disabled).     *
 * rec-red / live-green keep OBS values (untouched anywhere here).         *
 * Gradient lives ONLY on Start Streaming/Recording buttons.               *
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'WeaR Light';
    id: 'com.wearstudio.WeARLight';
    extends: 'com.obsproject.Yami';
    author: 'WeaR Studio';
    dark: 'false';
}

@OBSThemeVars {
    --bg_window: #F2F3F8;
    --bg_base: #FFFFFF;
    --bg_preview: #14161D;

    --border_color: #DCDFE7;

    --input_bg: #FFFFFF;
    --input_bg_hover: #FFFFFF;
    --input_bg_focus: #FFFFFF;
    --button_bg_hover: #E8EAF1;
    --button_bg_down: #DCDFE7;

    --primary: #0342CA;
    --primary_light: #553FD5;
    --primary_lighter: #BF48D9;
    --primary_dark: #022E9E;
    --primary_darker: #022072;

    --highlight_color: #0342CA;

    --text: #14161D;
    --text_light: #14161D;
    --text_muted: #5B6072;

    --border_radius: 8px;
    --border_radius_small: 4px;
    --border_radius_large: 8px;
}

/* Base text */
QWidget:disabled {
    color: #9AA0B4;
}

/* Push buttons */
QPushButton {
    background-color: #FFFFFF;
    color: #14161D;
    border: 1px solid #DCDFE7;
    border-radius: 8px;
}
QPushButton:hover {
    background-color: #E8EAF1;
    border-color: #DCDFE7;
}
QPushButton:hover,
QPushButton:focus {
    border-color: #0342CA;
}
QPushButton:pressed,
QPushButton:pressed:hover {
    background-color: #DCDFE7;
    border-color: #0342CA;
}
QPushButton:checked {
    background-color: #0342CA;
    border-color: #0342CA;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #EDEFF5;
    border-color: #DCDFE7;
    color: #9AA0B4;
}

/* Start Streaming / Start Recording: the ONLY gradient in the UI */
#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #3FC6CC, stop: 0.5 #0342CA, stop: 1 #553FD5);
    color: #FFFFFF;
    border: 1px solid #0342CA;
    border-radius: 8px;
}
#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #3FC6CC, stop: 0.5 #0342CA, stop: 1 #553FD5);
    color: #FFFFFF;
    border-color: #553FD5;
    border-radius: 8px;
}

/* Tool buttons */
QToolButton {
    background-color: transparent;
    color: #14161D;
    border: 1px solid transparent;
    border-radius: 8px;
}
QToolButton:hover {
    background-color: #E8EAF1;
    border-color: #DCDFE7;
}
QToolButton:pressed,
QToolButton:pressed:hover {
    background-color: #DCDFE7;
    border-color: #0342CA;
}
QToolButton:checked {
    background-color: #0342CA;
    color: #FFFFFF;
}
QToolButton:disabled {
    background-color: transparent;
    color: #9AA0B4;
}

/* Scenes/Sources action icons: dark variants for light surfaces */
.icon-plus {
    qproperty-icon: url(theme:WeaRLight/plus.svg);
}
.icon-minus {
    qproperty-icon: url(theme:WeaRLight/minus.svg);
}
.icon-up {
    qproperty-icon: url(theme:WeaRLight/up.svg);
}
.icon-down {
    qproperty-icon: url(theme:WeaRLight/down.svg);
}
.icon-gear {
    qproperty-icon: url(theme:WeaRLight/settings/general.svg);
}
.icon-filter {
    qproperty-icon: url(theme:WeaRLight/filter.svg);
}

/* Combo boxes + popup */
QComboBox {
    background-color: #FFFFFF;
    color: #14161D;
    border: 1px solid #DCDFE7;
    border-radius: 8px;
}
QComboBox:hover {
    border-color: #DCDFE7;
    background-color: #E8EAF1;
}
QComboBox:focus {
    border-color: #0342CA;
}
QComboBox:pressed {
    background-color: #DCDFE7;
}
QComboBox:disabled {
    background-color: #EDEFF5;
    color: #9AA0B4;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #14161D;
    border: 1px solid #DCDFE7;
    selection-background-color: #0342CA;
    selection-color: #FFFFFF;
    outline: none;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #E8EAF1;
}

/* Line edits + spin boxes */
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #14161D;
    border: 1px solid #DCDFE7;
    border-radius: 8px;
    selection-background-color: #0342CA;
    selection-color: #FFFFFF;
}
QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    background-color: #FFFFFF;
    border-color: #B9BFD0;
}
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #0342CA;
}
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #EDEFF5;
    color: #9AA0B4;
}

/* Check boxes + radio buttons (drawn indicators, no image dependency) */
QCheckBox,
QRadioButton {
    color: #14161D;
    spacing: 8px;
}
QCheckBox:disabled,
QRadioButton:disabled {
    color: #9AA0B4;
}
QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #B9BFD0;
    background-color: #FFFFFF;
}
QCheckBox::indicator {
    border-radius: 4px;
}
QRadioButton::indicator {
    border-radius: 7px;
}
QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #0342CA;
}
QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #0342CA;
    border-color: #0342CA;
}
QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #EDEFF5;
    border-color: #DCDFE7;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #DCDFE7;
    border-radius: 2px;
}
QSlider::groove:vertical {
    width: 4px;
    background-color: #DCDFE7;
    border-radius: 2px;
}
QSlider::handle:horizontal,
QSlider::handle:vertical {
    background-color: #5B6072;
    border: 1px solid #DCDFE7;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -5px 0;
}
QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    background-color: #0342CA;
    border-color: #0342CA;
}
QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background-color: #022E9E;
}
QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background-color: #9AA0B4;
}
QSlider::add-page:horizontal,
QSlider::sub-page:horizontal,
QSlider::add-page:vertical,
QSlider::sub-page:vertical {
    background-color: transparent;
}

/* Lists (Scenes/Sources: neutral hover, solid accent select) */
QListWidget,
QListView {
    background-color: #FFFFFF;
    color: #14161D;
    border: 1px solid #DCDFE7;
    border-radius: 8px;
    outline: none;
}
QListWidget::item,
QListView::item {
    background-color: transparent;
    color: #14161D;
    border: 1px solid transparent;
    border-radius: 4px;
}
QListWidget::item:hover,
QListView::item:hover {
    background-color: #E8EAF1;
    color: #14161D;
}
QListWidget::item:selected,
QListView::item:selected {
    background-color: #0342CA;
    color: #FFFFFF;
    border-color: #0342CA;
}
QListWidget::item:selected:hover,
QListView::item:selected:hover {
    background-color: #0342CA;
    color: #FFFFFF;
}
QListWidget:disabled,
QListView:disabled {
    color: #9AA0B4;
}

/* Scroll bars: thin, minimal */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
}
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #B9BFD0;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #5B6072;
}
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background-color: #0342CA;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
    border: none;
}

/* Menu bar + menus */
QMenuBar {
    background-color: #F2F3F8;
    color: #14161D;
}
QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #E8EAF1;
    color: #14161D;
    border-radius: 4px;
}
QMenu {
    background-color: #FFFFFF;
    color: #14161D;
    border: 1px solid #DCDFE7;
    border-radius: 8px;
}
QMenu::item {
    background-color: transparent;
    color: #14161D;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #0342CA;
    color: #FFFFFF;
}
QMenu::item:disabled {
    color: #9AA0B4;
}
QMenu::separator {
    height: 1px;
    background-color: #DCDFE7;
}

/* Group boxes */
QGroupBox {
    color: #14161D;
    border: 1px solid #DCDFE7;
    border-radius: 8px;
    background-color: #FFFFFF;
}
QGroupBox::title {
    color: #5B6072;
}

/* Dock widget title bars */
QDockWidget {
    color: #14161D;
}
QDockWidget::title {
    background-color: #FFFFFF;
    color: #5B6072;
    text-align: left;
}
QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #E8EAF1;
}

/* Progress bars */
QProgressBar {
    background-color: #FFFFFF;
    color: #14161D;
    border: 1px solid #DCDFE7;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #0342CA;
    border-radius: 2px;
}
QProgressBar:disabled {
    color: #9AA0B4;
}

/* Tool tips */
QToolTip {
    background-color: #FFFFFF;
    color: #14161D;
    border: 1px solid #DCDFE7;
    border-radius: 4px;
}

/* Video preview must never be rounded: it is content, not chrome */
OBSQTDisplay {
    border-radius: 0px;
}
